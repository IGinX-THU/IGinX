# Copy beside config.properties as security.properties to enable security mode.
# Without that file, legacy behavior is preserved. An empty file enables RPC,
# SQL, REST and MQTT authentication without metadata ACLs or reserved prefixes.
# Restrict file access to the service account (chmod 600 on Unix).
# Uncomment each complete group you use. Replace placeholders with independent
# randomly generated secrets of at least 20 characters; do not commit secrets.

# zookeeper.user=iginx_meta
# zookeeper.password=REPLACE_WITH_A_RANDOM_SECRET
# zookeeper.acl=creator

# etcd.user=iginx_meta
# etcd.password=REPLACE_WITH_ANOTHER_RANDOM_SECRET

# internal.secret=REPLACE_WITH_A_SHARED_CLUSTER_SECRET
# internal.auth=required

